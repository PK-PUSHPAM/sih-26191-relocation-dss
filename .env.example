# ==============================================================================
# SIH 26191 - Environment Configuration Template
# COPY THIS FILE TO .env AND UPDATE CONFIGURATION VALUES.
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sih_chamoli_dss
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih_chamoli_dss

# GIS / Spatial Configuration
CANONICAL_CRS_EPSG=32644
CANONICAL_GRID_RESOLUTION_M=30
STUDY_AREA_DISTRICT="Chamoli"
STUDY_AREA_STATE="Uttarakhand"

# Directory Paths
DATA_RAW_DIR=data/raw
DATA_STAGING_DIR=data/staging
DATA_CURATED_DIR=data/curated
DATA_DERIVED_DIR=data/derived
CONFIG_DIR=config

# External Data Source URLs & API Endpoints (Refer to config/sources.yaml)
# Note: Use public endpoints without embedding private keys
USDMA_BASE_URL=https://usdma.uk.gov.in
NWIC_BASE_URL=https://nwdp.nwic.gov.in
BHUVAN_BASE_URL=https://bhuvan-app1.nrsc.gov.in
